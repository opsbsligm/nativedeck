+def xbox_stick(g, label, directions=(), press=False, advance=640):
+    """Xbox stick label plus motion arrows; a press points down ABOVE the label.
+
+    Motion arrows sit below the label, so down motion and clicking are distinct.
+    These PUA identities were checked against the player's External.bfotf;
+    E048/E04A (power/home), E066 (console) and E067 (settings) are not sticks.
+    """
+    def draw(pen):
+        cx = advance / 2
+        circle(pen, cx, CY, R)
+        if press:
+            g.hole(pen, label, cx, CY - 75, 175, 350)
+            arrow_hole(pen, '↓', cx, CY + 150, 155)
+        elif directions:
+            g.hole(pen, label, cx, CY + 85, 175, 350)
+            if len(directions) == 4:
+                for direction, x, y in (('↑', cx, CY - 50), ('↓', cx, CY - 195),
+                                        ('←', cx - 120, CY - 122), ('→', cx + 120, CY - 122)):
+                    arrow_hole(pen, direction, x, y, 110)
+            else:
+                for i, direction in enumerate(directions):
+                    x = cx + (i - (len(directions) - 1) / 2) * 160
+                    arrow_hole(pen, direction, x, CY - 125, 155)
+        else:
+            g.hole(pen, label, cx, CY, R * 0.95, R * 1.3)
+    return advance, draw
+
