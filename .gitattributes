# 证据归档与取证输出为只读快照，禁止换行转换污染哈希核对
*.txt binary
*.json -text
*.md text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.cs text eol=lf
*.sh text eol=lf
*.rules text eol=lf
*.xml text eol=lf
*.ini text eol=lf
# Unified diff context markers are literal spaces; keep archived patch bytes intact.
patches/botw-sdk7-20261029/*.patch -text whitespace=-blank-at-eol
# A unified diff deliberately retains context prefixes and upstream CRLF bytes.
ports/ultratears-linux/linux.patch -text whitespace=-blank-at-eol
# Native port validation evidence is ordinary UTF-8 text.
ports/ultratears-linux/evidence/*.txt text diff
# Preserve pinned public fixtures/licenses; checkout must not change their SHA.
ports/ultratears-linux/cache-tests/fixture/** -text whitespace=cr-at-eol
ports/ultratears-linux/cache-tests/LICENSE -text whitespace=cr-at-eol
ports/ultratears-linux/controller-art/vendor/** -text whitespace=cr-at-eol
# Literal unified-diff context and EOF markers are part of the checked patch.
ports/ultratears-linux/cache-tests/vkb_bc7.patch -text -whitespace
